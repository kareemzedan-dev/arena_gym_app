# API Configuration
API_BASE_URL_DEV=https://app.arenagym-om.com/?gmgt_json_api
API_BASE_URL_PROD=https://app.arenagym-om.com/?gmgt_json_api

# Monitoring Server Configuration  
MONITOR_SERVER_URL_DEV=https://monitor.arenagym-om.com
MONITOR_SERVER_URL_PROD=https://monitor.arenagym-om.com

# API Endpoints
MONITOR_ERROR_ENDPOINT=/api/log-error
MONITOR_PERFORMANCE_ENDPOINT=/api/log-performance
MONITOR_USER_ACTION_ENDPOINT=/api/log-user-action

# Performance Monitoring Settings
ENABLE_PERFORMANCE_MONITORING=false
PERFORMANCE_CACHE_TIMEOUT=300000
API_TIMEOUT=30000

# Error Monitoring Settings
ENABLE_ERROR_MONITORING=false
LOG_LEVEL=debug