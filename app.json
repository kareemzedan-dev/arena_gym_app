{
  "expo": {
    "name": "Arena Gym",
    "slug": "arena_gym_app",
    "icon": "./assets/icon.png",
    "owner": "1st99m",
    "version": "4.0.6",
    "scheme": "arenagym",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["android", "ios", "web"],
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Arena Gym to use the camera to scan member QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 140,
          "backgroundColor": "#101716"
        }
      ]
    ],
    "android": {
      "package": "com.arenagym.app",
      "versionCode": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#30afb5"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.arenagym.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "b6642ad0-4188-4fe2-99e2-ca2b877f3d97"
      }
    }
  }
}
