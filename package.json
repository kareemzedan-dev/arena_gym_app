{
  "name": "arena-gym-mobile",
  "version": "4.0.5",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "export": "expo export --platform all --max-workers 2",
    "check": "npm run typecheck && npm test",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "test:live": "node scripts/test-live.cjs",
    "preview": "node scripts/preview.mjs",
    "review:api": "node scripts/live-review.cjs",
    "format": "prettier --write \"app/**/*.tsx\" \"mobile/**/*.{ts,tsx}\" \"tests/*.ts\" \"e2e/*.ts\""
  },
  "dependencies": {
    "@arena/shared": "file:packages/contracts",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~58.0.25",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "~19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/cli": {
      "glob": "14.0.2"
    },
    "@expo/fingerprint": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    }
  }
}
